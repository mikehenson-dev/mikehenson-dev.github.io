<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mike Henson | IT Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0a0a0f;
            color: #f5f5f5;
            line-height: 1.6;
        }

        header {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 8%;
            background: rgba(10, 10, 15, 0.9);
            backdrop-filter: blur(10px);
            z-index: 1000;
            border-bottom: 1px solid #222;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .logo span {
            color: #00e5ff;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav a {
            color: #ddd;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: #00e5ff;
        }

        section {
            padding: 100px 8%;
        }

        #home {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background:
                radial-gradient(circle at 80% 30%, #12313a 0%, transparent 30%),
                #0a0a0f;
        }

        .hero {
            max-width: 800px;
        }

        .hero small {
            color: #00e5ff;
            font-size: 16px;
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 85px);
            line-height: 1.05;
            margin: 15px 0;
        }

        .hero h1 span {
            color: #00e5ff;
        }

        .hero p {
            color: #aaa;
            max-width: 650px;
            font-size: 18px;
        }

        .buttons {
            margin-top: 30px;
        }

        .btn {
            display: inline-block;
            padding: 12px 25px;
            margin-right: 10px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .primary {
            background: #00e5ff;
            color: #000;
        }

        .primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 20px rgba(0, 229, 255, 0.4);
        }

        .secondary {
            border: 1px solid #444;
            color: white;
        }

        .secondary:hover {
            border-color: #00e5ff;
            color: #00e5ff;
        }

        .section-title {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .section-title span {
            color: #00e5ff;
        }

        .subtitle {
            color: #888;
            margin-bottom: 40px;
        }

        .about {
            max-width: 850px;
            color: #bbb;
            font-size: 17px;
        }

        .skills {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .skill-card {
            background: #111118;
            border: 1px solid #222;
            padding: 25px;
            border-radius: 12px;
            transition: 0.3s;
        }

        .skill-card:hover {
            transform: translateY(-5px);
            border-color: #00e5ff;
        }

        .skill-card h3 {
            margin-bottom: 10px;
            color: #00e5ff;
        }

        .skill-card p {
            color: #999;
        }

        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
            gap: 25px;
        }

        .project {
            background: #111118;
            border: 1px solid #222;
            border-radius: 12px;
            padding: 25px;
            transition: 0.3s;
        }

        .project:hover {
            transform: translateY(-5px);
            border-color: #00e5ff;
        }

        .project h3 {
            color: #00e5ff;
            margin-bottom: 10px;
        }

        .project p {
            color: #999;
        }

        .tags {
            margin-top: 15px;
        }

        .tag {
            display: inline-block;
            padding: 5px 10px;
            margin: 3px;
            border-radius: 20px;
            background: #1b1b25;
            color: #aaa;
            font-size: 12px;
        }

        .education {
            background: #0d0d13;
        }

        .education-box {
            border-left: 3px solid #00e5ff;
            padding-left: 20px;
            max-width: 700px;
        }

        .education-box h3 {
            font-size: 22px;
        }

        .education-box p {
            color: #999;
        }

        .contact-box {
            max-width: 650px;
            background: #111118;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #222;
        }

        .contact-box p {
            margin: 10px 0;
            color: #aaa;
        }

        .contact-box a {
            color: #00e5ff;
            text-decoration: none;
        }

        footer {
            text-align: center;
            padding: 30px;
            border-top: 1px solid #222;
            color: #666;
        }

        @media (max-width: 700px) {
            header {
                padding: 15px 5%;
            }

            nav ul {
                gap: 10px;
            }

            nav a {
                font-size: 12px;
            }

            section {
                padding: 80px 6%;
            }

            .hero h1 {
                font-size: 50px;
            }
        }
    </style>
</head>

<body>

